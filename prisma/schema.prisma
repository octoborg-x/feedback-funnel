generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  productName    String?
  reviewCount    Int
  qualityLevel   String
  qualityScore   Float
  productRisk    Int
  integrityRisk  Int
  anomalyRisk   Int
  scaleReady    Int
  verdict       String
  reason        String
  confidence    Float
  reviews       Review[]
}

model Review {
  id        String   @id @default(cuid())
  reportId  String
  report   Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  text     String
  rating   Float?
  date     DateTime?
  verified Boolean?
}
